NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Real production domain — MUST be set before deploying (used for sitemap.xml and OG/canonical
# URL resolution). Defaults to localhost if unset; see NOTES.md Section 15.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only (never NEXT_PUBLIC_): same value as the backend's INTERNAL_API_KEY. Server-side
# fetches send it so SSR/ISR traffic isn't rate-limited per IP. Optional locally.
INTERNAL_API_KEY=
# Section 19 — error monitoring (src/instrumentation.ts / src/instrumentation-client.ts). No
# real Sentry project exists yet; Sentry.init() is skipped entirely while this is unset.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (sourcemap upload) — a CI/deploy secret, never committed, never NEXT_PUBLIC_.
# Leave unset locally; the build works identically either way (next.config.ts's silent:true).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Only for scripts/check-urls.ts against a protected Vercel preview (Settings → Deployment
# Protection → Protection Bypass for Automation). Never needed by the app itself.
VERCEL_AUTOMATION_BYPASS_SECRET=
